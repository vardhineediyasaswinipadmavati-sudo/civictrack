# CivicTrack Backend API Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Option A (Default SRV format):
# MONGODB_URI=mongodb+srv://<dbUser>:<dbPassword>@cluster0.abcde.mongodb.net/civictrack?retryWrites=true&w=majority
# Option B (Standard non-SRV replica-set format - use if local DNS throws querySrv EBADRESP):
# MONGODB_URI=mongodb://<dbUser>:<dbPassword>@cluster0-shard-00-00.abcde.mongodb.net:27017,cluster0-shard-00-01.abcde.mongodb.net:27017,cluster0-shard-00-02.abcde.mongodb.net:27017/civictrack?ssl=true&replicaSet=atlas-xxx-shard-0&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<dbUser>:<dbPassword>@cluster0.abcde.mongodb.net/civictrack?retryWrites=true&w=majority

# Optional: Custom DNS Resolvers for Node.js (Fixes querySrv EBADRESP when local Wi-Fi router fails SRV lookups)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional: Dedicated Test Database URI for Integration Tests
MONGODB_TEST_URI=

# Authentication & Session Security (Mandatory strong secret in production)
JWT_SECRET=civictrack_jwt_secret_dev_key_2026_bhimavaram

# Canonical Client Application URL (For email password reset links and CORS policy)
APP_URL=https://civictrack-7gf8.onrender.com

# Cloudinary Permanent Image Storage (Required in production for complaint and repair photos)
# Obtain from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Service Provider for Outgoing Password Reset Delivery (Optional in dev, required in prod)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CivicTrack Bhimavaram <noreply@civictrack.org>
SMTP_SECURE=false

# Optional Admin Account Provisioning on Initial Startup (If users collection is empty)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Allow demo evaluation accounts in non-production (Set to false in production)
ALLOW_DEMO_ACCOUNTS=true
