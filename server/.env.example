# CivicTrack Backend API Server Environment Configuration
PORT=5000
NODE_ENV=development

# Authentication & Session Security (Replace with a secure random 64-char string in production)
JWT_SECRET=civictrack_jwt_secret_dev_key_2026_bhimavaram

# Database Storage Location
DB_PATH=./data/civictrack.sqlite

# Client Application URL (For email password reset links and CORS)
APP_URL=http://localhost:5173

# Optional: Email Service Provider for Password Reset Delivery
# In development, leave blank to use the secure simulated local token endpoint
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CivicTrack Bhimavaram <noreply@civictrack.org>

# Enable local reset token preview in response when email provider is unconfigured (Development only)
ENABLE_LOCAL_RESET_PREVIEW=true
